# Copy to .env (gitignored). Never commit real keys.
# docker compose loads this file via env_file.

# Groq — agent.py / LLM tools (leave empty until you have a key)
GROQ_API_KEY=

# FastAPI JWT signing — set a long random value in .env, not in Compose
JWT_SECRET_KEY=

# Shared Redis broker/backend for API + Celery workers + Flower
REDIS_URL=redis://localhost:6379/0
