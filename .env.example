# Shared Redis broker/backend for API + Celery workers + Flower
# Host processes (uvicorn/celery on the laptop):
REDIS_URL=redis://localhost:6379/0

# Copy this file to `.env` at the repo root before `docker compose up`.
# Compose overrides REDIS_URL inside containers to redis://redis:6379/0.

GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
API_BASE_URL=http://127.0.0.1:8000

JWT_SECRET_KEY=brasaland-dev-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

FLOWER_UNAUTHENTICATED_API=true

SUPABASE_URL=
SUPABASE_KEY=

QDRANT_HOST=localhost
QDRANT_PORT=6333
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

VITE_API_PROXY=http://127.0.0.1:8000
