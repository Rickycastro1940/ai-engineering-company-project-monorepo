# Copy to .env at the repo root (gitignored). Compose loads this via env_file.
# Never put real keys in docker-compose.yml or any Dockerfile.
#
#   cp .env.example .env

# --- ui service (Next.js website :3000 + backoffice :3001) ---
NODE_ENV=development
# FastAPI from inside the ui container — Compose service name, not localhost
API_PROXY=http://backend:8000
VITE_API_PROXY=http://backend:8000

# --- backend service (Uvicorn :8000) ---
PYTHONPATH=/app
JWT_SECRET_KEY=

# --- optional: agent.py / Groq ---
GROQ_API_KEY=

# --- local Celery/Flower (not in this two-service compose file) ---
REDIS_URL=redis://localhost:6379/0
