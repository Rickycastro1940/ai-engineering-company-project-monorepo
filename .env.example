# Committed defaults for `docker compose up` from the repo root.
# Compose loads this file automatically. Copy to gitignored `.env` only when you
# need real secrets (JWT_SECRET_KEY, GROQ_API_KEY). Never put real keys here.

# --- ui service (Next.js website :3000 + backoffice :3001) ---
NODE_ENV=development
# FastAPI from inside the ui container — Compose service name, not localhost or an IP
API_PROXY=http://backend:8000
VITE_API_PROXY=http://backend:8000
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# --- backend service (Uvicorn :8000) ---
PYTHONPATH=/app
JWT_SECRET_KEY=

# --- optional: agent.py / Groq ---
GROQ_API_KEY=

# --- local Celery/Flower (not in this two-service compose file) ---
REDIS_URL=redis://localhost:6379/0
