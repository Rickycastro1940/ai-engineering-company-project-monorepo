{
  "framework": "vite",
  "installCommand": "npm ci --prefix uis/website",
  "buildCommand": "npm run build --prefix uis/website",
  "outputDirectory": "uis/website/dist",
  "rewrites": [{ "source": "/((?!assets/|favicon.svg).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
