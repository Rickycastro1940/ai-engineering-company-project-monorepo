{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/images/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    { "src": "/join", "dest": "/loyalty.html" },
    { "src": "/locations", "dest": "/locations.html" },
    { "src": "/brasa-points", "dest": "/loyalty.html" },
    { "src": "/menu", "dest": "/menu.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
