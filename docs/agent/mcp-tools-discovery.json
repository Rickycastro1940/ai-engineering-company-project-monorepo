  {
    "name": "query_inventory",
    "title": "Query Brasaland inventory (read-only)",
    "description": "Read-only lookup of Brasaland inventory products/stock from the live inventory manager (GET /inventory/products — products.csv-backed). Use product_id for one product or name_contains to filter by name. Allowed actions: query | get | list | read. Write operations are NOT supported: any action of update/create/delete/write/patch/put OR any non-empty quantity/delta/unit/name field is explicitly rejected with error_code INVENTORY_WRITE_FORBIDDEN (the write tool is not omitted — it fails with a clear code). On success returns {ok:true, products:[{product_id,name,quantity,unit,source}]}. Requires OAuth Bearer token with scope inventory:read.",
    "inputSchema": {
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "query",
          "description": "Read-only action. Allowed: query | get | list | read (default query). Write-oriented values (update, create, delete, write, patch, put) are rejected with INVENTORY_WRITE_FORBIDDEN.",
          "title": "Action"
        },
        "product_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional product id from products.csv (e.g. '1').",
          "title": "Product Id"
        },
        "name_contains": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional case-insensitive name substring filter.",
          "title": "Name Contains"
        },
        "quantity": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "WRITE FIELD — not permitted. Any value triggers INVENTORY_WRITE_FORBIDDEN.",
          "title": "Quantity"
        },
        "delta": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "WRITE FIELD — not permitted. Any value triggers INVENTORY_WRITE_FORBIDDEN.",
          "title": "Delta"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "WRITE FIELD — not permitted. Non-empty value triggers INVENTORY_WRITE_FORBIDDEN.",
          "title": "Unit"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "WRITE FIELD for create/rename — not permitted. Use name_contains to filter reads instead.",
          "title": "Name"
        }
      },
      "title": "tool_query_inventoryArguments",
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "InventoryProduct": {
          "additionalProperties": true,
          "description": "One product row from the inventory manager (products.csv-backed).",
          "properties": {
            "product_id": {
              "description": "Product id, e.g. '1'.",
              "title": "Product Id",
              "type": "string"
            },
            "name": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Product display name.",
              "title": "Name"
            },
            "quantity": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "On-hand quantity.",
              "title": "Quantity"
            },
            "unit": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Unit of measure, e.g. kg.",
              "title": "Unit"
            },
            "source": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": "inventory_manager",
              "description": "Always inventory_manager for live backend data.",
              "title": "Source"
            }
          },
          "required": [
            "product_id"
          ],
          "title": "InventoryProduct",
          "type": "object"
        }
      },
      "additionalProperties": true,
      "description": "Structured result of ``query_inventory`` (read-only).",
      "properties": {
        "ok": {
          "description": "True when the inventory query succeeded.",
          "title": "Ok",
          "type": "boolean"
        },
        "products": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/InventoryProduct"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Matching products from GET /inventory/products.",
          "title": "Products"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional note (e.g. no matches) or error text.",
          "title": "Message"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Machine-readable error when ok is false. Write attempts always return INVENTORY_WRITE_FORBIDDEN. Other codes: VALIDATION_ERROR, NOT_FOUND, UPSTREAM_ERROR, AUTH_INSUFFICIENT_SCOPE.",
          "title": "Error Code"
        },
        "tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tool name on error payloads.",
          "title": "Tool"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional details (e.g. rejected write fields).",
          "title": "Details"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Tool latency in milliseconds.",
          "title": "Duration Ms"
        }
      },
      "required": [
        "ok"
      ],
      "title": "QueryInventoryOutput",
      "type": "object"
    },
    "icons": null,
    "annotations": null,
    "meta": null,
    "execution": null
  }
