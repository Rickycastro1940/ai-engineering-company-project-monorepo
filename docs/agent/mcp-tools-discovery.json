[
  {
    "name": "manage_incident_ticket",
    "title": "Manage Brasaland incident tickets",
    "description": "Create, update status, or query an incident ticket in the Brasaland Incidents Manager (live HTTP API — not a mock). Actions: create | update | get_status. create requires category+description; update requires ticket_id+status and always calls PATCH /api/incidents/{id}/status (lifecycle only); get_status requires ticket_id. Statuses: ABIERTO | CERRADO | DESCARTADO. On success returns {ok:true, action, ticket:{incident_id,status,…}}. On failure returns {ok:false, error_code, message} with distinct codes (VALIDATION_ERROR, NOT_FOUND, LIFECYCLE_ERROR, UPSTREAM_ERROR, AUTH_INSUFFICIENT_SCOPE). Requires OAuth Bearer token with scope incidents:manage.",
    "inputSchema": {
      "properties": {
        "action": {
          "description": "create: open a new ticket (needs category+description). update: change status via PATCH /api/incidents/{id}/status (needs ticket_id+status). get_status: look up one ticket (needs ticket_id).",
          "enum": [
            "create",
            "update",
            "get_status"
          ],
          "title": "Action",
          "type": "string"
        },
        "ticket_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for update and get_status. Example: BRS-000002.",
          "title": "Ticket Id"
        },
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for create. Categories from Incidents Manager: EQUIPAMIENTO | ABASTECIMIENTO | QUEJA_CLIENTE | CALIDAD_ALIMENTO | PERSONAL.",
          "title": "Category"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Required for create. Short description of the incident.",
          "title": "Description"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For create: initial status (default ABIERTO). For update: target status only — ABIERTO | CERRADO | DESCARTADO. update always calls PATCH /api/incidents/{id}/status.",
          "title": "Status"
        },
        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional ISO date for create (YYYY-MM-DD).",
          "title": "Date"
        },
        "location_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional location id for create (e.g. COL-01, FLA-02).",
          "title": "Location Id"
        },
        "customer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional customer id for create.",
          "title": "Customer Id"
        },
        "satisfaction_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional satisfaction score for create (IncidentCreateInput field).",
          "title": "Satisfaction Score"
        },
        "reporter_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional reporter id for create.",
          "title": "Reporter Id"
        }
      },
      "required": [
        "action"
      ],
      "title": "tool_manage_incident_ticketArguments",
      "type": "object"
    },
